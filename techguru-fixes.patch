diff --git a/css/nav-glass.css b/css/nav-glass.css
new file mode 100644
index 0000000..d7eb870
--- /dev/null
+++ b/css/nav-glass.css
@@ -0,0 +1,63 @@
+/* TECHGURU — Glass floating nav (loads AFTER layout-v2). Hides on scroll-down, returns on scroll-up. */
+:root { --tg-nav-h: 84px; --nav-gap: 14px; }
+html { scroll-padding-top: 96px; }
+main > section { scroll-margin-top: 96px; }
+
+.navbar {
+  top: var(--nav-gap); left: 0; right: 0; margin-inline: auto;
+  width: min(1240px, calc(100% - 2 * var(--tg-gutter, 1.5rem)));
+  height: 64px; padding: 0 10px 0 16px; flex-wrap: nowrap;
+  display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; column-gap: clamp(.75rem, 2vw, 2rem);
+  border-radius: 999px;
+  background: linear-gradient(135deg, rgba(255,255,255,.11), rgba(255,255,255,.035)), rgba(10,12,26,.5);
+  backdrop-filter: blur(24px) saturate(180%); -webkit-backdrop-filter: blur(24px) saturate(180%);
+  border: 1px solid rgba(255,255,255,.14);
+  box-shadow: 0 12px 40px -14px rgba(0,0,0,.75), inset 0 1px 0 rgba(255,255,255,.18);
+  transition: transform .5s cubic-bezier(.2,.7,.2,1), background-color .3s, box-shadow .3s, opacity .3s;
+}
+.navbar.is-scrolled, .navbar.navbar-scrolled {
+  background: linear-gradient(135deg, rgba(255,255,255,.09), rgba(255,255,255,.03)), rgba(8,10,22,.68);
+  box-shadow: 0 18px 50px -16px rgba(0,0,0,.9), inset 0 1px 0 rgba(255,255,255,.16);
+}
+.navbar.navbar-hidden { transform: translateY(calc(-100% - 32px)); opacity: 0; pointer-events: none; }
+
+.nav-logo-icon { width: 38px; height: 38px; border-radius: 11px; }
+.nav-menu { margin: 0; justify-self: center; min-width: 0; }
+.nav-menu ul { gap: .15rem; }
+.nav-menu ul li a { padding: .5rem .95rem; border-radius: 999px; font-size: .9rem; color: var(--tg-muted, rgba(242,244,250,.7)); transition: background .25s, color .25s; }
+.nav-menu ul li a::after { display: none; }
+.nav-menu ul li a:hover { background: rgba(255,255,255,.07); color: #fff; }
+.nav-menu ul li a.is-active { background: rgba(255,255,255,.12); color: #fff; box-shadow: inset 0 0 0 1px rgba(255,255,255,.1); }
+
+.navbar-actions { margin: 0; gap: .5rem; flex-wrap: nowrap; }
+.nav-phone-link { width: 42px; height: 42px; justify-content: center; border-radius: 50%; background: rgba(255,255,255,.07); border: 1px solid rgba(255,255,255,.12); transition: background .25s, transform .25s; }
+.nav-phone-link:hover { background: rgba(100,222,223,.16); transform: translateY(-1px); }
+.nav-cta-btn { padding: .65rem 1.15rem; border-radius: 999px; font-size: .88rem; white-space: nowrap; }
+
+@media (max-width: 1280px) { .nav-hide-md { display: none; } }
+
+@media (max-width: 992px) {
+  .navbar { display: flex; justify-content: space-between; height: 60px; border-radius: 22px; }
+  .navbar-actions { margin-left: auto; }
+  .nav-toggle { order: 3; }
+  .nav-menu { position: fixed; top: calc(100% + 10px); left: 0; right: 0; margin: 0; padding: .9rem; border-radius: 22px; max-height: calc(100vh - 110px);
+    background: rgba(10,12,26,.82); border: 1px solid rgba(255,255,255,.14); backdrop-filter: blur(24px) saturate(180%); -webkit-backdrop-filter: blur(24px) saturate(180%); }
+  .nav-menu ul li a { display: block; padding: .8rem 1rem; border-radius: 14px; }
+  .nav-hide-md { display: list-item; }
+}
+body.light-theme .navbar { background: linear-gradient(135deg, rgba(255,255,255,.7), rgba(255,255,255,.4)), rgba(244,246,251,.5); border-color: rgba(10,12,26,.1); }
+@media (prefers-reduced-motion: reduce) { .navbar { transition-duration: .001ms !important; } }
+
+/* ---- Layout fixes found in audit ---- */
+main > section { overflow-x: clip; }                                 /* tg-orb glows no longer create sideways page scroll */
+.portfolio-grid, .about-grid, .lead-magnet-content, .contact-wrapper { grid-template-columns: minmax(0, 1fr); }
+@media (min-width: 993px) { .about-grid, .lead-magnet-content, .contact-wrapper { grid-template-columns: revert-layer; } }
+.portfolio-grid > *, .about-grid > *, .lead-magnet-content > *, .contact-wrapper > * { min-width: 0; max-width: 100%; }
+
+/* mobile panel: full pill width + solid enough to read over hero copy (nested backdrop-filter doesn't blur) */
+@media (max-width: 992px) {
+  .nav-menu { width: 100%; box-sizing: border-box; justify-self: stretch; background: rgba(10,12,26,.95); }
+}
+/* hero location badge: was wrapping into a cramped 4-line pill */
+.hero-location-badge { display: inline-flex; flex-wrap: wrap; align-items: center; gap: .3rem .7rem; padding: .6rem 1.1rem; border-radius: 18px; line-height: 1.35; }
+.hero-location-badge > svg { flex: none; }
diff --git a/css/story.css b/css/story.css
new file mode 100644
index 0000000..bff14e9
--- /dev/null
+++ b/css/story.css
@@ -0,0 +1,17 @@
+/* TECHGURU — Story layer: chapter title cards, hero scrub, staggered card entrances. All opt-in via html.js-story. */
+main > section { isolation: isolate; }
+.tg-chapter { position: absolute; top: clamp(1rem, 4vw, 3rem); right: var(--tg-gutter, 2rem); z-index: -1; pointer-events: none; text-align: right; user-select: none;
+  translate: calc(var(--p, 0) * -6vw) 0; }
+.tg-chapter-num { display: block; font-family: var(--tg-font-display, Poppins, sans-serif); font-weight: 700; line-height: .8; font-size: clamp(6rem, 17vw, 14rem);
+  color: transparent; -webkit-text-stroke: 1px rgba(255,255,255,.12); letter-spacing: -.04em; }
+.tg-chapter-name { display: inline-flex; align-items: center; gap: .75rem; margin-top: .6rem; font-size: .72rem; letter-spacing: .3em; text-transform: uppercase; color: var(--tg-accent, #64dedf); opacity: .8; }
+.tg-chapter-name::before { content: ""; width: 56px; height: 1px; background: currentColor; transform-origin: right; transform: scaleX(var(--in, 0)); transition: transform 1.1s cubic-bezier(.2,.7,.2,1); }
+body.light-theme .tg-chapter-num { -webkit-text-stroke-color: rgba(10,12,26,.14); }
+
+.js-story .hero-content { translate: 0 calc(var(--hp, 0) * 70px); scale: calc(1 - var(--hp, 0) * .06); opacity: calc(1 - var(--hp, 0) * .9); transform-origin: 50% 0; will-change: translate, scale; }
+.js-story .hero-image, .js-story #hero-rotator { scale: calc(1 + var(--hp, 0) * .08); }
+
+.js-story .tg-stag { opacity: 0; translate: 0 32px; scale: .985; transition: opacity .9s cubic-bezier(.2,.7,.2,1), translate 1s cubic-bezier(.2,.7,.2,1), scale 1s cubic-bezier(.2,.7,.2,1); transition-delay: calc(var(--i, 0) * 90ms); }
+.js-story .tg-stag.tg-in { opacity: 1; translate: none; scale: none; }
+@media (max-width: 700px) { .tg-chapter-num { font-size: 6rem; } }
+@media (prefers-reduced-motion: reduce) { .tg-chapter { translate: none; } }
